{
  "manifest_version": 3,
  "name": "Avatar — Shop your size",
  "version": "1.0",
  "description": "Instantly filter any online store to show only products in your size and style.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
  "https://*/*",
  "http://*/*",
  "https://api.anthropic.com/*"
],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Avatar"
  },
  "content_scripts": [
  {
    "matches": [
      "http://localhost/*",
      "http://localhost:*/*",
      "https://localhost/*",
      "https://localhost:*/*",
      "https://*/*",
      "http://*/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }
]
}